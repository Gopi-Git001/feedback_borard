# Team Feedback Board: environment template.
#
# Copy to .env and edit:   cp .env.example .env
# .env is git-ignored. NEVER commit real values; this file holds placeholders only.
# In any non-local deployment the values come from the platform's secret store.
#
# Variable names and rules come from docs/project/stack.md ("Environment
# variables" table), ADR-002 (auth, rate limits), ADR-003 (invite token) and
# ADR-004 (security baseline, database roles). Do not rename them.
# Values are placed on their own lines (no inline comments) so that docker
# compose and python dotenv parsers read them identically.

# ---------------------------------------------------------------------------
# Application mode (ADR-002, ADR-004)
# ---------------------------------------------------------------------------
# One of: development, test, production. There is no default: the backend
# refuses to start when it is unset, empty or any other value (fail closed).
# Every relaxation below (COOKIE_SECURE=false, RATE_LIMIT_ENABLED=false) is
# allowed only with development or test.
APP_ENV=development

# ---------------------------------------------------------------------------
# Secrets (ADR-002, ADR-003)
# ---------------------------------------------------------------------------
# JWT_SECRET: HS256 signing key for access and refresh JWTs.
# Rule checked at startup: unpadded base64url that decodes to AT LEAST 32 BYTES,
# at least 16 distinct characters, and no weak or placeholder fragment.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is rejected by the backend on purpose. Replace it.
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_secrets_token_urlsafe_48

# INVITE_TOKEN_KEY: HMAC key that derives the invite token (ADR-003).
# Same rule as JWT_SECRET (unpadded base64url, decodes to AT LEAST 32 BYTES),
# and it MUST NOT EQUAL JWT_SECRET (the backend refuses to start if they match).
# Generate one with:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
# The placeholder below is rejected by the backend on purpose. Replace it.
# Rotation runbook: ADR-003.
INVITE_TOKEN_KEY=REPLACE_WITH_OUTPUT_OF_secrets_token_bytes_32_base64url

# ---------------------------------------------------------------------------
# Database container (compose service "db")
# Names chosen by devops-bot (stack.md leaves them open). POSTGRES_* are read by
# the official postgres image; compose refuses to start db when a password is empty.
# ---------------------------------------------------------------------------
# Owner role: created by the image from POSTGRES_USER, owns the database and is
# used by Alembic migrations (ADR-004 section 5). In the official image this
# bootstrap role is a PostgreSQL superuser.
POSTGRES_USER=feedback_owner
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=feedback_board
# Restricted application role, created by db/init/01-roles.sh on the FIRST start
# of an empty volume only (changing these later does not alter an existing
# volume; run "docker compose down -v" to start fresh, which deletes the data).
# Keep APP_DB_USER and APP_DB_PASSWORD in step with DATABASE_URL below.
APP_DB_USER=feedback_app
APP_DB_PASSWORD=change-me-app-password
# Host port for db, published on 127.0.0.1 only (never on all interfaces).
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Database connections (ADR-004 section 5)
# ---------------------------------------------------------------------------
# DATABASE_URL: runtime connection of the backend, as the restricted
# NON-OWNER role (SELECT, INSERT, UPDATE, DELETE only; no DDL), created by
# db/init/01-roles.sh. User and password must match APP_DB_USER and
# APP_DB_PASSWORD above.
# Host is localhost for a backend run on the host; compose services use "db".
DATABASE_URL=postgresql+psycopg://feedback_app:change-me-app-password@localhost:5432/feedback_board
# DATABASE_MIGRATION_URL: used only by Alembic migrations, as the OWNER role
# (the same user and password as POSTGRES_USER and POSTGRES_PASSWORD above).
# The backend never uses it at runtime.
DATABASE_MIGRATION_URL=postgresql+psycopg://feedback_owner:change-me-owner-password@localhost:5432/feedback_board

# ---------------------------------------------------------------------------
# HTTP, cookies and proxy (ADR-002, ADR-004)
# ---------------------------------------------------------------------------
# FRONTEND_ORIGIN: the one allowed browser origin (CSRF Origin check, CORS).
# Bare origin: scheme://host[:port], no path, no trailing slash.
# Local dev default port 8080 (fixed by devops-bot; the compose frontend
# service of TASK-007 must publish it).
FRONTEND_ORIGIN=http://localhost:8080
# COOKIE_SECURE: Secure flag of the refresh cookie. Default is true.
# false is allowed ONLY with APP_ENV development or test (plain http locally);
# the backend exits at startup otherwise.
COOKIE_SECURE=false
# TRUSTED_PROXY_IPS: comma-separated exact IP addresses of the reverse proxy
# whose X-Forwarded-For is believed. No *, no 0.0.0.0/0, no ::/0.
# 172.28.0.10 is the fixed nginx address of ADR-002; the compose network that
# gives nginx this address is created in TASK-007.
TRUSTED_PROXY_IPS=172.28.0.10

# ---------------------------------------------------------------------------
# Tuning (ADR-002); the values shown are the defaults
# ---------------------------------------------------------------------------
# Concurrent Argon2 hashes per worker (integer 1-64); 64 MiB each.
ARGON2_MAX_CONCURRENCY=4
# Seconds (0-60) in which a just-rotated refresh token gets 401 without
# revoking its family (two browser tabs racing).
REFRESH_REUSE_LEEWAY_SECONDS=10

# ---------------------------------------------------------------------------
# Rate limits (ADR-002). Format <max>/<window_seconds>; defaults are 10/60.
# ---------------------------------------------------------------------------
# RATE_LIMIT_ENABLED: switches ALL limits off when false. Default is true.
# false is for TEST runs only and is refused with APP_ENV=production (or unset
# or unknown). e2e, load and CI test runs set it to false (the SPA calls refresh
# on every page load, so one client IP would hit 429 after 10 calls in 60 s),
# EXCEPT one e2e job and the TASK-010 rate-limit tests, which keep it true.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SIGNUP_PER_IP=10/60
RATE_LIMIT_LOGIN_PER_IP=10/60
RATE_LIMIT_REFRESH_PER_IP=10/60
RATE_LIMIT_INVITE_PREVIEW_PER_IP=10/60
RATE_LIMIT_INVITE_ACCEPT_PER_IP=10/60
RATE_LIMIT_ORG_CREATE_PER_USER=10/60
